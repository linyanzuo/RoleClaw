{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipm.dev/schemas/aipm-marker.schema.json",
  "title": "AIPM Version Marker",
  "description": "版本标记文件 .aipm 的格式约束。由 aipm pull 在安装目录下自动写入，AI 工具不扫描此文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "语义化版本号，必须与 registry 中该 artifact 的版本一致"
    },
    "registryPath": {
      "type": "string",
      "description": "Registry 路径，用于 push/add 时回写。如 @scope/name 或 name"
    },
    "installedAt": {
      "type": "string",
      "format": "date-time",
      "description": "安装时间（ISO 8601），可选"
    },
    "source": {
      "type": "string",
      "description": "Registry 来源标识，可选"
    }
  }
}
