{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roleclaw.dev/schemas/role.schema.json",
  "title": "RoleClaw Role Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roleId",
    "name",
    "department",
    "description",
    "requiredSkills",
    "optionalSkills",
    "requiredRules",
    "optionalRules",
    "extends",
    "status"
  ],
  "properties": {
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "department": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "requiredSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "optionalSkills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "requiredRules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "optionalRules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "extends": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    }
  }
}
