{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipm.dev/schemas/registry.schema.json",
  "title": "AIPM Registry Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packages", "rules"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:shared|[a-z0-9]+(?:-[a-z0-9]+)*)\\/[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latest", "versions", "description", "tags"],
        "properties": {
          "latest": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:shared|[a-z0-9]+(?:-[a-z0-9]+)*)\\/[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latest", "versions", "description", "tags"],
        "properties": {
          "latest": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
